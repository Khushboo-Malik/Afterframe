# Copy to backend/.env and fill in the blanks yourself.
# backend/.env is gitignored. Never commit it and never paste keys into chat.
# Settings load it with override=True, so these values beat any work
# variables already in your shell (DATABASE_URL, GOOGLE_API_KEY, AWS_*, ...).

# --- Django ---
DEBUG=true
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# prod: https://<vercel-domain>
CSRF_TRUSTED_ORIGINS=
# DRF proxy count for the throttle: local 0, prod 2 (Vercel + Nginx)
NUM_PROXIES=0

# --- Local dev services (deploy/docker-compose.dev.yml) ---
DATABASE_URL=postgres://afterframe:afterframe@localhost:55432/afterframe
REDIS_URL=redis://localhost:56379/0
# 0 for web (ASGI), 60 for worker/beat
DB_CONN_MAX_AGE=0

# --- Gemini (AI Studio key under the personal `afterframe` Google project) ---
GEMINI_API_KEY=
# Chosen for cost: $0.30 in / $2.50 out per 1M tokens (vs $0.75 / $3.75 for gemini-3.8-flash).
GEMINI_MODEL=gemini-3.5-flash-lite
# low | medium | high
GEMINI_MEDIA_RESOLUTION=low

# --- Places API (New) + YouTube Data API v3 (server key, same Google project) ---
GOOGLE_SERVER_API_KEY=

# --- Optional overrides ---
# GLOBAL_DAILY_NEW=10
# Honored only when DEBUG=true
RATE_LIMIT_DISABLED=false

# --- Optional LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=afterframe
# Needed for service keys (lsv2_sk_...): LangSmith → Settings → Workspaces → ID
LANGSMITH_WORKSPACE_ID=
