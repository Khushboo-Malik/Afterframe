# Production variables for the Railway "web" and "worker" services.
# Fill them in on Railway (a service's Variables tab → RAW Editor accepts this
# format). Never commit real values, never paste them into chat.
# There is no .env file in production: the image ignores backend/.env.

# --- Django ---
DEBUG=false
# Generate locally: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The web service's Railway domain, Railway's healthcheck host, and the Vercel domain
ALLOWED_HOSTS=<web>.up.railway.app,healthcheck.railway.app,<project>.vercel.app
# The admin login form is posted from the Vercel origin
CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app
# Vercel + Railway's edge sit in front of Django (checked after the first deploy)
NUM_PROXIES=2

# --- Redis: the Railway Redis service's private URL (a reference, not a copy) ---
REDIS_URL=${{Redis.REDIS_URL}}

# --- Supabase: Connect → Session pooler (IPv4). Add ?sslmode=require at the end.
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F ...).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# web: 0 (the default; ASGI should not keep connections). worker only: set 60.
# DB_CONN_MAX_AGE=60

# --- Gemini (same values as local) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MEDIA_RESOLUTION=low

# --- Places API (New) + YouTube Data API v3 server key ---
GOOGLE_SERVER_API_KEY=

# --- Optional LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=afterframe
LANGSMITH_WORKSPACE_ID=
