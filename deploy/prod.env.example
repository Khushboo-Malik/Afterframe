# Template for the SERVER's /opt/afterframe/backend/.env (production).
# Write it by hand in the Session Manager shell (nano). Never commit the real one,
# never paste its values into chat. REDIS_URL and DB_CONN_MAX_AGE are set per
# service in deploy/docker-compose.prod.yml, so they are not needed here.

# --- Django ---
DEBUG=false
# Generate on the server: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Elastic IP, the Vercel domain, and localhost (for checks on the server itself)
ALLOWED_HOSTS=<elastic-ip>,<project>.vercel.app,localhost
# The admin login form is posted from the Vercel origin
CSRF_TRUSTED_ORIGINS=https://<project>.vercel.app
# Vercel + Nginx sit in front of Django
NUM_PROXIES=2

# --- Supabase: Connect → Session pooler (IPv4). Add ?sslmode=require at the end.
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F ...).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# --- Gemini (same values as local) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MEDIA_RESOLUTION=low

# --- Places API (New) + YouTube Data API v3 server key ---
GOOGLE_SERVER_API_KEY=

# --- Optional LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=afterframe
LANGSMITH_WORKSPACE_ID=
