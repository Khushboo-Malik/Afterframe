# Copy to frontend/.env.local and fill in the blanks yourself (never paste keys into chat).
# The frontend never holds Gemini, Places or YouTube Data keys.

# Server-only: where Next.js proxies /api, /admin, /django-static, /mcp
BACKEND_URL=http://localhost:8000

# Browser key, restricted to localhost (and later the Vercel domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Leave empty until the demo video exists (the demo block is hidden when unset)
NEXT_PUBLIC_DEMO_YOUTUBE_ID=
